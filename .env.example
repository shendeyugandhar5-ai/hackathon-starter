# ==============================================================================
# Hackathon Starter - Environment Configuration Template
# Copy this file to .env before starting the services
# ==============================================================================

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=True

# CORS Configuration (comma-separated list of allowed origins)
# Add your own UI's origin here if it runs on a port not listed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Dev escape hatch: allow any origin. Handy while wiring up a separate UI;
# turn it off before deploying anywhere public.
CORS_ALLOW_ALL=False

# Primary Database Connection (Supabase PostgreSQL / Cloud or Local Docker)
# Example Supabase Direct: postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# Example Supabase Pooler: postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Optional Local Docker PostgreSQL Fallback (used only if DATABASE_URL is left blank)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres

# LLM / Agent Layer Configuration (backend/app/agents)
# Get this sorted first (idea.md section 7.1) - every workstream needs it.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
ROUTER_CONFIDENCE_THRESHOLD=0.6

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
